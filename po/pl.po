msgstr "Żółty"

msgid "Yellow DVB subtitles"
msgstr "Żółte napisy DVB"


msgid "Yellow button (long)"
msgstr "Żółty przycisk (długo)"


msgid "Yellow button (short)"
msgstr "Żółty przycisk (krótko)"

msgid "Yellow long"
msgstr "Żółty (długo)"


msgid "Yemen"
msgstr "Jemen"

msgid "Yes"
msgstr "Tak"

msgid "Yes (save index in setup tuner)"
msgstr "Tak (zapisz indeks w konfiguracji głowicy)"

msgid "Yes to all"
msgstr "Tak dla wszystkich"

msgid "Yes, always"
msgstr "Tak, zawsze"

msgid "Yes, and delete this movie"
msgstr "Tak, i usuń ten film"

msgid "Yes, and return to the movie list"
msgstr "Tak, i wróć do listy filmów"

msgid "Yes, backup my settings!"
msgstr "Tak, zrób kopię zapasową moich ustawień!"

msgid "Yes, but don't save timeshift as movie"
